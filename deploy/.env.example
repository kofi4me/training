KRYPTNET_DOMAIN=www.kryptnet.org
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
KRYPTNET_ADMIN_IDS=

# Learner email verification. Keep the password and code secret on the server.
TRAINING_SMTP_CONFIG=
TRAINING_SMTP_HOST=
TRAINING_SMTP_PORT=587
TRAINING_SMTP_SECURITY=starttls
TRAINING_SMTP_USER=
TRAINING_SMTP_PASSWORD=
TRAINING_SMTP_FROM=
TRAINING_CODE_SECRET=

# Keep files unless PostgreSQL has been confirmed, provisioned, and migrated.
KRYPTNET_STORAGE=files
KRYPTNET_DATABASE_URL=
KRYPTNET_DATABASE_TLS=verify-full

# Use sandbox credentials on staging. Leave blank until the merchant is set up.
AUTHORIZE_NET_MODE=sandbox
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_SIGNATURE_KEY=
