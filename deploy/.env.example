KRYPTNET_DOMAIN=lab.your-domain.example
OIDC_ISSUER=https://your-identity-provider.example
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-server-secret
KRYPTNET_ADMIN_IDS=

# Keep files unless PostgreSQL has been confirmed, provisioned, and migrated.
KRYPTNET_STORAGE=files
KRYPTNET_DATABASE_URL=
KRYPTNET_DATABASE_TLS=verify-full
